{
  "expo": {
    "name": "Sailsforce",
    "slug": "sailsforce",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "sailsforce",
    "assetBundlePatterns": ["**/*"],
